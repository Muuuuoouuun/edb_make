{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classin.local/schemas/edb-quality-corpus-v1.json",
  "title": "ClassIn EDB quality corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "cases"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "case_thresholds": {"$ref": "#/$defs/caseThresholds"},
    "aggregate_thresholds": {"$ref": "#/$defs/aggregateThresholds"},
    "regression_tolerance": {"$ref": "#/$defs/regressionTolerance"},
    "coverage_requirements": {"$ref": "#/$defs/coverageRequirements"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "nonnegative": {"type": "number", "minimum": 0},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "passageRange": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "dependentRequired": {"sha256": ["path"]},
          "properties": {
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "format": {"enum": ["pdf", "hwp", "hwpx", "image", "synthetic"]},
            "subject": {"type": "string"}
          }
        },
        "result": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {"path": {"type": "string", "minLength": 1}}
            }
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question_numbers", "passage_ranges"],
          "properties": {
            "question_numbers": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "uniqueItems": true
            },
            "passage_ranges": {
              "type": "array",
              "items": {"$ref": "#/$defs/passageRange"}
            },
            "problem_signatures": {
              "type": "array",
              "items": {"$ref": "#/$defs/problemSignature"}
            }
          }
        },
        "ground_truth": {"$ref": "#/$defs/groundTruth"}
      }
    },
    "groundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "labeled", "approved"]},
        "annotation_revision": {"type": "integer", "minimum": 1},
        "annotator_id": {"type": "string", "minLength": 1},
        "labeled_at": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "allow_empty_document": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["labeled", "approved"]}}},
          "then": {
            "required": [
              "annotation_revision",
              "annotator_id",
              "labeled_at",
              "expected_sha256"
            ]
          }
        },
        {
          "if": {"properties": {"status": {"const": "approved"}}},
          "then": {"required": ["reviewer_id", "reviewed_at"]}
        }
      ]
    },
    "coverageRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_cases": {"type": "integer", "minimum": 1},
        "required_formats": {
          "type": "array",
          "items": {"enum": ["pdf", "hwp", "hwpx", "image"]},
          "uniqueItems": true
        },
        "required_subjects": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "problemSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "sourcePageId",
        "bboxSha256",
        "cropSha256",
        "renderSha256",
        "visualSha256",
        "contentSha256",
        "choiceCount",
        "choiceOrder",
        "artifactValid",
        "artifactSizeBytes"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "sourcePageId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bboxSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cropSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "renderSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "visualSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "choiceCount": {"type": "integer", "minimum": 0},
        "choiceOrder": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "artifactValid": {"const": true},
        "artifactSizeBytes": {"type": "integer", "minimum": 1}
      }
    },
    "caseThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_question_count_max": {"$ref": "#/$defs/nonnegative"},
        "duplicate_question_count_max": {"$ref": "#/$defs/nonnegative"},
        "extra_question_count_max": {"$ref": "#/$defs/nonnegative"},
        "question_recall_min": {"$ref": "#/$defs/ratio"},
        "question_precision_min": {"$ref": "#/$defs/ratio"},
        "missing_passage_range_count_max": {"$ref": "#/$defs/nonnegative"},
        "extra_passage_range_count_max": {"$ref": "#/$defs/nonnegative"},
        "passage_range_recall_min": {"$ref": "#/$defs/ratio"},
        "passage_range_precision_min": {"$ref": "#/$defs/ratio"},
        "preflight_issue_count_max": {"$ref": "#/$defs/nonnegative"},
        "manual_review_rate_max": {"$ref": "#/$defs/ratio"},
        "processing_ms_max": {"$ref": "#/$defs/nonnegative"},
        "problem_signature_mismatch_count_max": {"$ref": "#/$defs/nonnegative"},
        "artifact_invalid_count_max": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "aggregateThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_question_count_max": {"$ref": "#/$defs/nonnegative"},
        "duplicate_question_count_max": {"$ref": "#/$defs/nonnegative"},
        "extra_question_count_max": {"$ref": "#/$defs/nonnegative"},
        "question_recall_min": {"$ref": "#/$defs/ratio"},
        "question_precision_min": {"$ref": "#/$defs/ratio"},
        "missing_passage_range_count_max": {"$ref": "#/$defs/nonnegative"},
        "extra_passage_range_count_max": {"$ref": "#/$defs/nonnegative"},
        "passage_range_recall_min": {"$ref": "#/$defs/ratio"},
        "passage_range_precision_min": {"$ref": "#/$defs/ratio"},
        "preflight_issue_count_max": {"$ref": "#/$defs/nonnegative"},
        "manual_review_rate_max": {"$ref": "#/$defs/ratio"},
        "processing_ms_p50_max": {"$ref": "#/$defs/nonnegative"},
        "processing_ms_p95_max": {"$ref": "#/$defs/nonnegative"},
        "case_failure_count_max": {"$ref": "#/$defs/nonnegative"},
        "problem_signature_mismatch_count_max": {"$ref": "#/$defs/nonnegative"},
        "artifact_invalid_count_max": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "regressionTolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question_recall_drop_max": {"$ref": "#/$defs/nonnegative"},
        "question_precision_drop_max": {"$ref": "#/$defs/nonnegative"},
        "passage_range_recall_drop_max": {"$ref": "#/$defs/nonnegative"},
        "passage_range_precision_drop_max": {"$ref": "#/$defs/nonnegative"},
        "manual_review_rate_increase_max": {"$ref": "#/$defs/nonnegative"},
        "preflight_issue_count_increase_max": {"$ref": "#/$defs/nonnegative"},
        "processing_ms_p95_increase_ratio_max": {"$ref": "#/$defs/nonnegative"}
      }
    }
  }
}
