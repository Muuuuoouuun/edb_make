{
  "name": "classin-edb-reports-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "predeploy": "npm test && node scripts/verify_deployment.mjs --remote --phase pre",
    "deploy": "wrangler deploy",
    "postdeploy": "node scripts/verify_deployment.mjs --remote --phase post",
    "verify:deploy:remote": "node scripts/verify_deployment.mjs --remote --phase post",
    "verify:deploy:local": "node scripts/verify_deployment.mjs --local --phase pre",
    "db:create": "wrangler d1 create classin-edb-reports",
    "db:migrate:local": "wrangler d1 migrations apply classin-edb-reports --local",
    "db:migrate:remote": "wrangler d1 migrations apply classin-edb-reports --remote"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
